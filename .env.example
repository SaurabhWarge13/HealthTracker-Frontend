# Copy this file to `.env` and fill it in. `.env` is gitignored.
#
# Editing `.env` requires `yarn start --reset-cache` — Babel inlines these
# values into the bundle, so Metro's cache holds the old ones otherwise.

# Which backend the app talks to. Exactly `server` or `local` — anything else
# (including a typo or a blank) fails on startup rather than guessing.
API_MODE=server

# The deployed Render backend. Must be https: release builds block cleartext
# HTTP on both platforms, so an http:// URL here cannot work in the APK.
SERVER_URL=https://<your-render-url>

# A backend running on your own machine (`cd ../Backend && npm run dev`).
# 10.0.2.2 is the Android emulator's alias for the host machine.
# iOS simulator: http://localhost:3000
# Physical device: http://<your-LAN-IP>:3000  (the backend prints this on boot)
LOCAL_URL=http://10.0.2.2:3000
